# Cloud sync (optional). Copy to ".env" for local dev, or set these as
# environment variables in your host (e.g. Netlify) for the deployed site.
# Without them, the app stores journals locally in your browser (IndexedDB).
#
# Get these from your Supabase project: Settings -> API.
VITE_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY
